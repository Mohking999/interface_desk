#include <windows.h>
#include "deskpilot_version.h"

IDI_DESKPILOT ICON "@CMAKE_CURRENT_SOURCE_DIR@/deskpilot.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DESKPILOT_VERSION_MAJOR,DESKPILOT_VERSION_MINOR,DESKPILOT_VERSION_PATCH,0
 PRODUCTVERSION DESKPILOT_VERSION_MAJOR,DESKPILOT_VERSION_MINOR,DESKPILOT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DeskPilot\0"
            VALUE "FileDescription", "DeskPilot desktop command palette and notes\0"
            VALUE "FileVersion", DESKPILOT_VERSION_STRING
            VALUE "InternalName", "DeskPilot\0"
            VALUE "OriginalFilename", "DeskPilot.exe\0"
            VALUE "ProductName", "DeskPilot\0"
            VALUE "ProductVersion", DESKPILOT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
